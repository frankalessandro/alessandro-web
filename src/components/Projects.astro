---
/**
 * Projects — "mission log" cards. Each personal project is a deployed mission:
 * mission code, orbit status, its own planet (with ring + moon in orbit),
 * a constellation that draws itself on reveal, and HUD corner brackets.
 * Entrance/hover choreography lives in src/scripts/animations.ts (projects()).
 */
const projects = [
  {
    code: 'MSN-01',
    title: 'Polla Mundialista 2026',
    descEs:
      'Quiniela para la fase de grupos del Mundial 2026: 72 predicciones por participante, puntos calculados con marcadores reales de TheSportsDB resueltos en build, clasificación con desempates y tablas filtrables. 100% estático.',
    descEn:
      'Prediction pool for the 2026 World Cup group stage: 72 picks per participant, points computed from real TheSportsDB scores resolved at build time, tie-break standings and filterable tables. 100% static.',
    tags: ['Astro', 'TypeScript', 'Tailwind 4', 'TheSportsDB'],
    repo: 'https://github.com/frankalessandro/polla-mundialista',
    demo: null,
    statusEs: 'EN ÓRBITA',
    statusEn: 'IN ORBIT',
    live: true,
    planet: '#fbbf24',
  },
  {
    code: 'MSN-02',
    title: 'Forge',
    descEs:
      'Tracker de entrenamientos de gimnasio, en solitario o en grupo con amigos. Autenticación y datos sobre Supabase (PostgreSQL + RLS), formularios validados con Zod + React Hook Form y estado global con Zustand.',
    descEn:
      'Gym workout tracker, solo or in groups with friends. Auth and data on Supabase (PostgreSQL + RLS), forms validated with Zod + React Hook Form and global state with Zustand.',
    tags: ['React 19', 'Supabase', 'Zustand', 'Tailwind 4'],
    repo: 'https://github.com/frankalessandro/forge',
    demo: null,
    statusEs: 'EN ÓRBITA',
    statusEn: 'IN ORBIT',
    live: true,
    planet: '#f97316',
  },
  {
    code: 'MSN-03',
    title: 'ClarBank',
    descEs:
      'Simulador bancario full-stack: roles (director, asesor, cajero, cliente), apertura de cuentas con formularios multi-paso, autorización de solicitudes y módulo de caja. API documentada con Swagger. Clasificó a nivel departamental y nacional en el XIII Encuentro de Semilleros de Investigación.',
    descEn:
      'Full-stack banking simulator: roles (director, advisor, teller, client), multi-step account opening, request authorization flows and a cash desk module. Swagger-documented API. Qualified at regional and national level in the XIII Research Incubator Meetup.',
    tags: ['React', 'Node.js', 'PostgreSQL', 'Swagger'],
    repo: 'https://github.com/frankalessandro/Simulador_Banca',
    demo: null,
    statusEs: 'MISIÓN CUMPLIDA',
    statusEn: 'MISSION COMPLETE',
    live: false,
    planet: '#38bdf8',
  },
  {
    code: 'MSN-04',
    title: 'VotApp',
    descEs:
      'Plataforma de votación electrónica con validación de identidad, usada por ~1200 aprendices del CBI Palmira. Redujo drásticamente el tiempo del proceso electoral frente al conteo manual.',
    descEn:
      'Electronic voting platform with identity validation, used by ~1200 CBI Palmira students. Dramatically reduced election time compared to manual counting.',
    tags: ['Astro', 'JavaScript', 'Tailwind'],
    repo: 'https://github.com/frankalessandro/VotApp',
    demo: 'https://vot-app.vercel.app',
    statusEs: 'EN ÓRBITA',
    statusEn: 'IN ORBIT',
    live: true,
    planet: '#6ee7b7',
  },
  {
    code: 'MSN-05',
    title: 'Felinas Web',
    descEs:
      'Sitio oficial de Pantera Felinas, academia de danza urbana femenina: landing con selector de sección, página de academia (estilos, planes, FAQ), sección de shows, animaciones on-scroll y agendamiento por WhatsApp.',
    descEn:
      'Official site for Pantera Felinas, a women’s urban dance academy: landing with section selector, academy page (styles, plans, FAQ), shows section, on-scroll animations and WhatsApp booking.',
    tags: ['Astro 6', 'React', 'Tailwind'],
    repo: 'https://github.com/frankalessandro/felinas-web',
    demo: null,
    statusEs: 'EN ÓRBITA',
    statusEn: 'IN ORBIT',
    live: true,
    planet: '#a78bfa',
  },
  {
    code: 'MSN-06',
    title: 'Spa Salud y Vida',
    descEs:
      'Sitio web para un spa y centro de bienestar: presentación de servicios y captación de clientes, construido estático con Astro y desplegado en Vercel.',
    descEn:
      'Website for a spa & wellness center: service showcase and client acquisition, statically built with Astro and deployed on Vercel.',
    tags: ['Astro', 'TypeScript', 'CSS'],
    repo: 'https://github.com/frankalessandro/spasaludyvida',
    demo: 'https://spasaludyvida.vercel.app',
    statusEs: 'EN ÓRBITA',
    statusEn: 'IN ORBIT',
    live: true,
    planet: '#22d3ee',
  },
];
---

<section id="projects" class="relative px-4 sm:px-6 py-28 md:py-40 max-w-6xl mx-auto">
  <!-- Decorative deep-space orbit rings behind the grid -->
  <div class="proj-orbits pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="proj-ring proj-ring-a"></span>
    <span class="proj-ring proj-ring-b"></span>
  </div>

  <p data-i18n="projects.label" data-anim-head class="relative text-accent font-mono text-xs tracking-widest uppercase mb-3">Proyectos</p>
  <h2 data-i18n="projects.title" data-proj-title class="relative text-3xl font-black text-text tracking-tight">Misiones desplegadas</h2>
  <p data-i18n="projects.sub" data-anim-head class="relative text-muted text-sm mt-3 mb-12 font-mono">
    Proyectos personales, construidos fuera de mi órbita laboral.
  </p>

  <div class="proj-grid relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {projects.map((p) => (
      <article
        data-project-card
        data-particle-hover
        class="proj-card group relative rounded-xl border border-border bg-bg-2 p-5 sm:p-6 flex flex-col gap-4 overflow-hidden"
        style={`--planet: ${p.planet};`}
      >
        <!-- cursor-tracking glow (position driven from animations.ts) -->
        <span class="proj-glow" aria-hidden="true"></span>

        <!-- HUD corner brackets -->
        <span class="proj-corner proj-corner-tl" aria-hidden="true"></span>
        <span class="proj-corner proj-corner-tr" aria-hidden="true"></span>
        <span class="proj-corner proj-corner-bl" aria-hidden="true"></span>
        <span class="proj-corner proj-corner-br" aria-hidden="true"></span>

        <!-- constellation that draws itself on reveal -->
        <svg class="proj-constellation absolute top-3 right-4 w-20 h-12 opacity-40" viewBox="0 0 80 48" fill="none" aria-hidden="true">
          <path d="M6 38 L26 14 L46 26 L66 8" stroke="var(--planet)" stroke-width="1" />
          <circle cx="6" cy="38" r="1.6" fill="var(--planet)" />
          <circle cx="26" cy="14" r="2.2" fill="var(--planet)" />
          <circle cx="46" cy="26" r="1.4" fill="var(--planet)" />
          <circle cx="66" cy="8" r="1.8" fill="var(--planet)" />
        </svg>

        <!-- mission header: code + status -->
        <div class="relative flex items-center justify-between font-mono text-[10px] tracking-widest">
          <span data-proj-code class="text-muted/70">{p.code}</span>
          <span class={`flex items-center gap-1.5 ${p.live ? 'text-accent/80' : 'text-sky-400/80'}`}>
            <span class={`proj-status-dot ${p.live ? 'bg-accent' : 'bg-sky-400'}`}></span>
            <span data-lang="es">{p.statusEs}</span>
            <span data-lang="en">{p.statusEn}</span>
          </span>
        </div>

        <!-- planet with ring + orbiting moon -->
        <div class="relative h-14 flex items-center">
          <div class="proj-planet-wrap">
            <span class="proj-planet"></span>
            <span class="proj-planet-ring" aria-hidden="true"></span>
            <span class="proj-moon-orbit" aria-hidden="true"><span class="proj-moon"></span></span>
          </div>
        </div>

        <div class="relative flex items-start justify-between gap-2">
          <h3 class="text-text font-semibold text-base tracking-tight">{p.title}</h3>
          <div class="flex gap-3 shrink-0 font-mono text-xs">
            <a
              href={p.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted hover:text-accent transition-colors"
              title="Repositorio"
              aria-label={`Repositorio de ${p.title}`}
            >
              [gh]
            </a>
            {p.demo && (
              <a
                href={p.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted hover:text-accent transition-colors"
                title="Demo"
                aria-label={`Demo de ${p.title}`}
              >
                [↗]
              </a>
            )}
          </div>
        </div>

        <p class="relative text-muted text-sm leading-relaxed flex-1">
          <span data-lang="es">{p.descEs}</span>
          <span data-lang="en">{p.descEn}</span>
        </p>

        <div class="relative flex flex-wrap gap-2 mt-auto">
          {p.tags.map((t) => (
            <span class="text-xs px-2 py-0.5 rounded font-mono text-accent border border-accent/20 bg-accent/5">
              {t}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* ── Deep-space deco: huge slow orbit rings behind the grid ─────────── */
  .proj-ring {
    position: absolute;
    border: 1px dashed rgba(110, 231, 183, 0.08);
    border-radius: 50%;
  }
  .proj-ring-a {
    width: 900px;
    height: 900px;
    top: -200px;
    right: -350px;
    animation: proj-spin 90s linear infinite;
  }
  .proj-ring-b {
    width: 600px;
    height: 600px;
    bottom: -250px;
    left: -250px;
    border-color: rgba(56, 189, 248, 0.07);
    animation: proj-spin 70s linear infinite reverse;
  }
  @keyframes proj-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Card chrome ─────────────────────────────────────────────────────── */
  .proj-card {
    transition: border-color 0.4s ease, box-shadow 0.5s ease;
    /* subtle nebula tint from the card's own planet color */
    background-image: radial-gradient(
      120% 90% at 85% -10%,
      color-mix(in srgb, var(--planet) 6%, transparent),
      transparent 55%
    );
  }
  .proj-card:hover {
    border-color: color-mix(in srgb, var(--planet) 35%, transparent);
    box-shadow: 0 18px 60px -18px color-mix(in srgb, var(--planet) 30%, transparent);
  }

  /* cursor-tracking glow — --mx/--my updated by GSAP quickSetter */
  .proj-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--planet) 10%, transparent),
      transparent 65%
    );
  }
  .proj-card:hover .proj-glow { opacity: 1; }

  /* HUD corner brackets — light up in the planet's color on hover */
  .proj-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid rgba(240, 240, 240, 0.12);
    transition: border-color 0.4s ease, width 0.35s ease, height 0.35s ease;
    pointer-events: none;
  }
  .proj-corner-tl { top: 6px; left: 6px; border-right: 0; border-bottom: 0; }
  .proj-corner-tr { top: 6px; right: 6px; border-left: 0; border-bottom: 0; }
  .proj-corner-bl { bottom: 6px; left: 6px; border-right: 0; border-top: 0; }
  .proj-corner-br { bottom: 6px; right: 6px; border-left: 0; border-top: 0; }
  .proj-card:hover .proj-corner {
    border-color: color-mix(in srgb, var(--planet) 70%, transparent);
    width: 18px;
    height: 18px;
  }

  /* blinking status dot (reuses the global `blink` keyframes) */
  .proj-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    animation: blink 1.6s ease-in-out infinite;
  }

  /* ── The planet: sphere + tilted ring + moon in orbit ───────────────── */
  .proj-planet-wrap {
    position: relative;
    width: 44px;
    height: 44px;
  }
  .proj-planet {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%,
        color-mix(in srgb, var(--planet) 95%, white),
        var(--planet) 42%,
        color-mix(in srgb, var(--planet) 35%, #000) 78%,
        color-mix(in srgb, var(--planet) 15%, #000) 100%);
    box-shadow:
      0 0 18px -2px color-mix(in srgb, var(--planet) 45%, transparent),
      inset -4px -4px 10px rgba(0, 0, 0, 0.55);
  }
  .proj-planet-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--planet) 40%, transparent);
    transform: rotateX(72deg) rotateZ(-18deg);
    transition: border-color 0.4s ease;
  }
  .proj-card:hover .proj-planet-ring {
    border-color: color-mix(in srgb, var(--planet) 75%, transparent);
  }
  .proj-moon-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    transform: rotateX(72deg) rotateZ(-18deg);
    animation: proj-orbit 5.5s linear infinite;
  }
  .proj-moon {
    position: absolute;
    top: -2px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--planet) 80%, white);
    box-shadow: 0 0 6px 1px color-mix(in srgb, var(--planet) 60%, transparent);
  }
  @keyframes proj-orbit {
    to { transform: rotateX(72deg) rotateZ(342deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-ring, .proj-moon-orbit, .proj-status-dot { animation: none; }
  }
</style>
