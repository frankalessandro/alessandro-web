---
/**
 * Projects — full-bleed showcase deck. One large card per project: screenshot
 * in a hairline-framed viewport, logo + title, description, stack and links.
 * On desktop the deck pins and each project hands off to the next with a
 * line-sweep transition (clip reveal + rolling index) driven by scroll.
 * Choreography lives in src/scripts/animations.ts (projects()).
 */
import { projects } from '../data/content';

const total = String(projects.length).padStart(2, '0');

// ── Tech icons ───────────────────────────────────────────────────────────
// Brand SVGs (simple-icons) inlined at build so each stack tag renders as a
// monochrome glyph tinted with the project accent instead of plain text.
// zustand / thesportsdb have no brand mark → hand-drawn fallbacks.
import astro from '../assets/tech/astro.svg?raw';
import typescript from '../assets/tech/typescript.svg?raw';
import javascript from '../assets/tech/javascript.svg?raw';
import tailwindcss from '../assets/tech/tailwindcss.svg?raw';
import react from '../assets/tech/react.svg?raw';
import supabase from '../assets/tech/supabase.svg?raw';
import zustand from '../assets/tech/zustand.svg?raw';
import nodedotjs from '../assets/tech/nodedotjs.svg?raw';
import postgresql from '../assets/tech/postgresql.svg?raw';
import swagger from '../assets/tech/swagger.svg?raw';
import css3 from '../assets/tech/css3.svg?raw';
import thesportsdb from '../assets/tech/thesportsdb.svg?raw';
import greensock from '../assets/tech/greensock.svg?raw';

const ICONS: Record<string, string> = {
  astro, typescript, javascript, tailwindcss, react, supabase,
  zustand, nodedotjs, postgresql, swagger, css3, thesportsdb, greensock,
};

// map a free-form tag label ("Tailwind 4", "Node.js") to an icon slug
const SLUG: Record<string, string> = {
  'astro': 'astro', 'astro 6': 'astro',
  'typescript': 'typescript',
  'javascript': 'javascript',
  'tailwind': 'tailwindcss', 'tailwind 4': 'tailwindcss', 'tailwind css': 'tailwindcss',
  'react': 'react', 'react 19': 'react',
  'supabase': 'supabase',
  'zustand': 'zustand',
  'node.js': 'nodedotjs', 'nodejs': 'nodedotjs',
  'postgresql': 'postgresql',
  'swagger': 'swagger',
  'css': 'css3',
  'thesportsdb': 'thesportsdb',
  'gsap': 'greensock',
};

const iconFor = (tag: string): string | null => ICONS[SLUG[tag.toLowerCase()]] ?? null;
---

<section id="projects" class="relative px-4 sm:px-6 py-28 md:py-40 max-w-6xl mx-auto">
  <p data-i18n="projects.label" data-anim-head class="relative text-accent font-mono text-xs tracking-widest uppercase mb-3">Proyectos</p>
  <h2 data-i18n="projects.title" data-proj-title class="relative text-3xl font-extrabold text-text tracking-tight">Trabajo seleccionado</h2>
  <p data-i18n="projects.sub" data-anim-head class="relative text-muted text-sm mt-3 mb-14 font-mono">
    Proyectos personales, diseñados y construidos de principio a fin.
  </p>

  <div class="proj-deck relative" data-proj-deck>
    <!-- rolling index: 01 → 06, plus jump-to-project dots -->
    <div class="proj-counter absolute -top-9 right-0 hidden lg:flex items-center gap-4">
      <div class="proj-dots flex items-center gap-2.5" data-proj-dots role="tablist" aria-label="Ir a un proyecto">
        {projects.map((p, i) => (
          <button
            type="button"
            class="proj-dot"
            data-proj-dot={i}
            role="tab"
            aria-current={i === 0 ? 'true' : 'false'}
            aria-label={`${p.title}`}
          ></button>
        ))}
      </div>
      <div class="flex items-baseline gap-1.5 font-mono text-xs tracking-widest text-muted" aria-hidden="true">
        <span class="proj-counter-viewport">
          <span class="proj-counter-track" data-proj-count>
            {projects.map((_, i) => (
              <span class="proj-counter-item text-text">{String(i + 1).padStart(2, '0')}</span>
            ))}
          </span>
        </span>
        <span class="opacity-60">/ {total}</span>
      </div>
    </div>

    <div class="proj-stage relative flex flex-col gap-20 lg:gap-0" data-proj-stage>
      {projects.map((p, i) => (
        <article
          data-proj-slide
          class="proj-slide grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 lg:gap-14 items-center"
          style={`--pc: ${p.accent};`}
        >
          <!-- ── Info column ─────────────────────────────────────────── -->
          <div class="proj-info relative order-2 lg:order-1">
            <!-- index + rule + status: one technical header line -->
            <div data-proj-el class="relative flex items-center gap-4 mb-6">
              <span class="proj-logo-tile shrink-0" aria-hidden="true">
                <img src={p.logo} alt="" width="24" height="24" loading="lazy" class="w-6 h-6 object-contain" />
              </span>
              <span class="proj-idx font-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="proj-idx-rule" aria-hidden="true"></span>
              <span class="flex items-center gap-2 font-mono text-[10px] tracking-widest shrink-0">
                <span class={`proj-status-dot ${p.live ? 'bg-accent' : 'bg-sky-400'}`}></span>
                <span class={p.live ? 'text-accent/80' : 'text-sky-400/80'}>
                  <span data-lang="es">{p.statusEs}</span>
                  <span data-lang="en">{p.statusEn}</span>
                </span>
              </span>
            </div>

            <h3 data-proj-el class="proj-title relative text-text font-extrabold text-3xl sm:text-4xl tracking-tight mb-6">
              {p.title}
            </h3>

            <p data-proj-el class="relative text-muted text-sm leading-relaxed mb-6 max-w-prose">
              <span data-lang="es">{p.descEs}</span>
              <span data-lang="en">{p.descEn}</span>
            </p>

            <ul data-proj-el class="proj-tags relative flex flex-wrap gap-2.5 mb-8 font-mono" role="list">
              {p.tags.map((t) => (
                <li class="proj-tag" title={t}>
                  {iconFor(t) && <span class="proj-tag-ico" aria-hidden="true" set:html={iconFor(t)} />}
                  <span class="proj-tag-label">{t}</span>
                </li>
              ))}
            </ul>

            <div data-proj-el class="relative flex gap-3 font-mono text-xs">
              {p.repo && (
                <a
                  href={p.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-reticle px-4 py-2 border border-border rounded text-text hover:border-accent/40 transition-colors"
                  aria-label={`Código de ${p.title} en GitHub`}
                >
                  <span data-lang="es">Código</span><span data-lang="en">Source</span>
                </a>
              )}
              {p.demo && (
                <a
                  href={p.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-reticle px-4 py-2 border border-accent/30 bg-accent/5 rounded text-accent hover:bg-accent/10 transition-colors"
                  aria-label={`Sitio de ${p.title}`}
                >
                  <span data-lang="es">Ver sitio ↗</span><span data-lang="en">Visit site ↗</span>
                </a>
              )}
            </div>
          </div>

          <!-- ── Screenshot window ───────────────────────────────────── -->
          <div class="proj-shot-wrap relative order-1 lg:order-2" data-proj-clip data-particle-hover>
            <figure class="proj-shot relative rounded-lg border border-border bg-bg-2 overflow-hidden">
              <!-- browser chrome: dots + favicon tab + hairline -->
              <div class="proj-shot-bar flex items-center gap-1.5 px-3 py-2 border-b border-border">
                <span class="proj-shot-dot"></span>
                <span class="proj-shot-dot"></span>
                <span class="proj-shot-dot"></span>
                <span class="proj-shot-tab ml-3 flex items-center gap-2">
                  <img src={p.logo} alt="" width="14" height="14" loading="lazy" class="w-3.5 h-3.5 object-contain" />
                  <span class="font-mono text-[10px] tracking-wide text-muted lowercase">{p.title}</span>
                </span>
                <span class="ml-3 flex-1 h-px bg-border"></span>
              </div>
              <div class="proj-shot-viewport max-sm:h-44 overflow-hidden">
                <img
                  src={p.shot}
                  alt={`Captura de ${p.title}`}
                  width="1440"
                  height="900"
                  loading="lazy"
                  data-proj-img
                  class="w-full h-auto max-sm:h-full max-sm:object-cover max-sm:object-top block"
                />
              </div>
              <!-- accent hairlines extending past the frame -->
              <span class="proj-shot-ext proj-shot-ext-t" aria-hidden="true"></span>
              <span class="proj-shot-ext proj-shot-ext-b" aria-hidden="true"></span>
            </figure>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Deck / stage ─────────────────────────────────────────────────────
     With motion + JS the slides stack absolutely and the deck is pinned so
     each project hands off to the next in place — on mobile too. Under
     reduced motion (or no JS) they flow as a normal stacked list. */
  @media (prefers-reduced-motion: no-preference) {
    html.js-anim .proj-stage {
      /* one card at a time, centered — sized to leave the card room to breathe
         within the pinned viewport (svh accounts for mobile browser chrome) */
      height: min(88vh, 680px);
      height: min(88svh, 680px);
      display: block;
    }
    html.js-anim .proj-slide {
      position: absolute;
      inset: 0;
      display: grid;
      align-content: center;
    }
    /* only the first slide is visible until GSAP takes over */
    html.js-anim .proj-slide:not(:first-child) { opacity: 0; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    html.js-anim .proj-stage {
      height: min(72vh, 620px);
    }
  }

  /* ── Jump-to-project dots ─────────────────────────────────────────────── */
  .proj-dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  .proj-dot:hover {
    border-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
  }
  .proj-dot[aria-current='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.4);
    box-shadow: 0 0 8px rgba(110, 231, 183, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .proj-dots { display: none; }
  }

  /* ── Rolling counter ──────────────────────────────────────────────────── */
  .proj-counter-viewport {
    display: inline-block;
    height: 1em;
    line-height: 1;
    overflow: hidden;
  }
  .proj-counter-track { display: block; }
  .proj-counter-item { display: block; height: 1em; line-height: 1; }

  /* ── Info column chrome ──────────────────────────────────────────────── */
  /* index: solid mono digits in the project's accent, sitting on a hairline
     rule that fades toward the status readout */
  .proj-idx {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--pc) 85%, white);
    text-shadow: 0 0 22px color-mix(in srgb, var(--pc) 45%, transparent);
  }
  .proj-idx-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--pc) 55%, transparent),
      color-mix(in srgb, var(--pc) 12%, transparent)
    );
  }
  /* title carries a short accent bar underneath — the section's signature line */
  .proj-title { padding-bottom: 0.9rem; }
  .proj-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 3rem;
    height: 2px;
    background: var(--pc);
    box-shadow: 0 0 12px color-mix(in srgb, var(--pc) 60%, transparent);
  }
  /* tags: technical chips — brand SVG glyph + mono label, accent-tinted icon */
  .proj-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.32rem 0.6rem 0.32rem 0.5rem;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--pc) 4%, transparent);
    transition: border-color 0.3s ease, color 0.3s ease, background 0.3s ease;
  }
  .proj-tag:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--pc) 40%, transparent);
    background: color-mix(in srgb, var(--pc) 9%, transparent);
  }
  .proj-tag-ico {
    display: inline-flex;
    width: 0.95rem;
    height: 0.95rem;
    color: color-mix(in srgb, var(--pc) 82%, white);
  }
  .proj-tag-ico :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .proj-tag-label { line-height: 1; }

  /* project logo reused as a framed tile in the info header */
  .proj-logo-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid color-mix(in srgb, var(--pc) 30%, transparent);
    background: color-mix(in srgb, var(--pc) 7%, transparent);
    box-shadow: 0 0 18px -6px color-mix(in srgb, var(--pc) 45%, transparent);
  }
  .proj-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    animation: blink 1.6s ease-in-out infinite;
  }

  /* ── Screenshot frame ────────────────────────────────────────────────── */
  .proj-shot {
    box-shadow: 0 24px 80px -24px color-mix(in srgb, var(--pc) 25%, transparent);
    transition: border-color 0.4s ease;
  }
  .proj-slide:hover .proj-shot {
    border-color: color-mix(in srgb, var(--pc) 40%, transparent);
  }
  .proj-shot-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--pc) 55%, transparent);
  }
  /* favicon "tab" in the window bar */
  .proj-shot-tab {
    padding: 0.2rem 0.6rem;
    border-radius: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--pc) 22%, transparent);
    background: color-mix(in srgb, var(--pc) 6%, transparent);
  }
  /* accent hairlines shooting out horizontally past the frame edges */
  .proj-shot-ext {
    position: absolute;
    height: 1px;
    width: 3rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--pc) 60%, transparent), transparent);
    pointer-events: none;
  }
  .proj-shot-ext-t { top: 0; left: 100%; }
  .proj-shot-ext-b {
    bottom: 0;
    right: 100%;
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-status-dot { animation: none; }
  }
</style>
