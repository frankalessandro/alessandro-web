---
import { Image } from 'astro:assets';
import studioImg from '../../assets/StudioPhoto.webp';

const roles = ['FULL STACK DEVELOPER', 'FRONTEND DEVELOPER', 'REACT & NODE.JS'];
---

<section id="hero" class="relative px-4 sm:px-6 pt-14 pb-10 max-w-6xl mx-auto overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-10 items-center">
    <div>
      <span
        data-brutal-hero-badge
        data-i18n="hero.available"
        class="brutal-stamp mb-6"
      >
        Disponible para trabajar
      </span>

      <h1 class="leading-[0.82] mb-6" style="font-family: var(--font-display);">
        <span class="block overflow-hidden">
          <span data-brutal-hero-word class="block text-[clamp(3.2rem,11vw,8rem)] uppercase tracking-tight">FRANK</span>
        </span>
        <span class="block overflow-hidden">
          <span data-brutal-hero-word class="block text-[clamp(3.2rem,11vw,8rem)] uppercase tracking-tight text-signal">ROLDAN</span>
        </span>
      </h1>

      <p
        data-brutal-hero-desc
        data-i18n="hero.desc"
        class="max-w-md text-sm leading-relaxed mb-7 pl-4"
        style="border-left: 3px solid var(--color-ink);"
      >
        Desarrollador Full Stack con más de 3 años de experiencia construyendo
        aplicaciones web escalables. Especializado en React, Node.js y APIs REST.
      </p>

      <div data-brutal-hero-actions class="flex flex-wrap items-center gap-3 mb-7">
        <a href="#projects" data-i18n="hero.cta.projects" class="stamp-btn stamp-btn--signal px-5 py-3 text-sm">
          Ver proyectos
        </a>
        <a href="#contact" data-i18n="hero.cta.contact" class="stamp-btn px-5 py-3 text-sm">
          Contacto
        </a>

        <a
          href="https://github.com/frankalessandro"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="stamp-btn w-11 h-11 !p-0 items-center justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/frank-alessandro/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="stamp-btn w-11 h-11 !p-0 items-center justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Photo: duotone + red ghost layer that misregisters away from the cursor -->
    <div
      data-brutal-hero-photo
      class="relative w-56 h-56 sm:w-72 sm:h-72 mx-auto lg:ml-auto lg:mr-0"
      style="border: 4px solid var(--color-ink); box-shadow: 10px 10px 0 0 var(--color-ink); transform: rotate(2deg);"
    >
      <div class="halftone absolute inset-0">
        <Image
          src={studioImg}
          alt="Foto de Frank Roldan"
          width={288}
          height={288}
          position="top"
          format="webp"
          quality={95}
        />
      </div>
      <div
        data-brutal-photo-ghost
        class="absolute inset-0 pointer-events-none"
        style="mix-blend-mode: multiply; opacity: 0.55; filter: sepia(1) saturate(8) hue-rotate(-52deg) contrast(1.15);"
      >
        <Image
          src={studioImg}
          alt=""
          width={288}
          height={288}
          position="top"
          format="webp"
          quality={70}
        />
      </div>
      <span class="absolute -bottom-4 -left-4 brutal-tag bg-acid">FRANK.EXE</span>
    </div>
  </div>

  <div class="mt-10 -mx-4 sm:-mx-6">
    <div class="brutal-marquee bg-ink text-paper">
      <div class="brutal-marquee-track" data-brutal-marquee-track="forward">
        {Array.from({ length: 6 }).flatMap(() =>
          roles.map((r) => <span class="brutal-marquee-item">{r}</span>)
        )}
      </div>
    </div>
  </div>
</section>
