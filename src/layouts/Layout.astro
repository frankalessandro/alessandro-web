---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alessandro | Developer',
  description = 'Portfolio de Alessandro — desarrollador web.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Always start at the top on load/reload -->
    <script is:inline>history.scrollRestoration = 'manual'; window.scrollTo(0, 0);</script>
    <!-- Init lang before paint — prevents flash of wrong lang -->
    <script is:inline>
      (function () {
        const l = localStorage.getItem('lang') || 'es';
        document.documentElement.dataset.lang = l;
        // Mark that JS is running so we can pre-hide GSAP-animated elements
        // before paint (prevents a flash of content before the intro plays).
        document.documentElement.classList.add('js-anim');
      })();
    </script>
    <!-- Fonts: preconnect first, then load the CSS non-blocking via print→all trick -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <!-- Intro loader: CSS-first so it's alive from the very first paint — the
         `</>` glyph draws itself, a terminal caret blinks and a progress line
         fills, all without waiting for the JS bundle. GSAP takes over when
         ready and sweeps the veil away. Shown only when JS is on (html.js-anim)
         so no-JS users never get a stuck overlay. -->
    <div id="intro-loader" aria-hidden="true">
      <div class="intro-veil"></div>
      <div class="intro-content">
        <div class="intro-mark">
          <Logo class="intro-logo" />
          <span class="intro-caret"></span>
        </div>
        <div class="intro-progress"><span class="intro-progress-fill"></span></div>
      </div>
    </div>

    <!-- Global starfield -->
    <canvas
      id="starfield"
      class="fixed inset-0 w-full h-full pointer-events-none z-0"
    ></canvas>

    <!-- Scroll progress bar -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 h-0.5 bg-accent z-9999 transition-[width] duration-80 ease-linear shadow-[0_0_8px_rgba(110,231,183,0.6)] w-0"
    ></div>

    <slot />

    <!-- Back to top button -->
    <button
      id="back-to-top"
      aria-label="Volver arriba"
      class="back-to-top fixed bottom-6 right-6 z-50 flex items-center gap-2 pl-3.5 pr-2.5 py-2.5 rounded-lg border border-accent/60 bg-bg-3/95 backdrop-blur-sm text-accent transition-all duration-200 opacity-0 pointer-events-none text-[11px] font-mono uppercase tracking-[0.14em]"
    >
      Volver arriba
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>

    <script>
      // GSAP animations (hero intro, scroll reveals, parallax, tilt)
      import '../scripts/animations.ts';
    </script>

    <script>
      // Back to top
      const btt = document.getElementById('back-to-top');
      function updateBtt() {
        if (!btt) return;
        if (window.scrollY > 300) {
          btt.style.opacity = '1';
          btt.style.pointerEvents = 'auto';
        } else {
          btt.style.opacity = '0';
          btt.style.pointerEvents = 'none';
        }
      }
      btt?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      window.addEventListener('scroll', updateBtt, { passive: true });
    </script>

    <script>
      // Scroll progress bar
      const bar = document.getElementById('scroll-progress');
      function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (bar) bar.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // Global starfield
      const canvasEl = document.getElementById('starfield');
      const ctx2d = canvasEl instanceof HTMLCanvasElement ? canvasEl.getContext('2d') : null;
      if (canvasEl instanceof HTMLCanvasElement && ctx2d) {
        // Non-null typed aliases so narrowing survives inside nested functions.
        const canvas: HTMLCanvasElement = canvasEl;
        const ctx: CanvasRenderingContext2D = ctx2d;
        {
          type Tone = 'white' | 'gray' | 'accent';
          interface Star {
            x: number; y: number; r: number; depth: number;
            baseAlpha: number; twinkleSpeed: number; phase: number; tone: Tone;
            // slow glow burst
            glowNext: number; glowStart: number; glowDur: number;
            // magnetism: spring displacement + velocity around the resting position
            vx: number; vy: number; dx: number; dy: number;
          }
          let stars: Star[] = [];
          let width = 0, height = 0;
          let dpr = Math.min(window.devicePixelRatio || 1, 2);
          let px = 0, py = 0, cx = 0, cy = 0;
          // Actual cursor position in CSS px (for constellation lines + magnetism);
          // parked off-screen until the first move so nothing connects on load.
          let mx = -9999, my = -9999;
          // "Antigravity" hover boost: toggled by [data-particle-hover] enter/leave,
          // smoothed each frame. Idle = gentle attraction; boosted = repulsion + brighter links.
          let hoverTarget = 0, hoverCur = 0;
          // Shooting stars (ambient, self-scheduled) + click supernovas (an
          // expanding ring that shoves nearby stars away).
          interface Meteor { x: number; y: number; vx: number; vy: number; born: number; dur: number; len: number; }
          interface Shock { x: number; y: number; born: number; }
          const meteors: Meteor[] = [];
          const shocks: Shock[] = [];
          let meteorNext = 0; // scheduled on the draw clock, first one shortly after start
          let lastT = 0;

          const rand = (min: number, max: number) => Math.random() * (max - min) + min;

          function pickTone(): Tone {
            const n = Math.random();
            if (n < 0.35) return 'accent'; // verdes
            if (n < 0.6) return 'gray';     // grises
            return 'white';                  // blancas
          }

          function buildStars() {
            const base = Math.floor((width * height) / 4800);
            const count = Math.min(lowPower ? 320 : 390, lowPower ? base : Math.floor(base * 1.15));
            // Uniform distribution across the whole viewport; the text guard
            // keeps copy readable, so no need to bias stars away from center.
            stars = Array.from({ length: count }, () => {
              return {
              x: Math.random() * width,
              y: Math.random() * height,
              r: rand(0.5, 1.8),
              depth: rand(0.2, 1),
              baseAlpha: rand(0.35, 0.95),
              twinkleSpeed: rand(0.15, 0.45),
              phase: rand(0, Math.PI * 2),
              tone: pickTone(),
              // glow: first burst after a short random delay, then repeats on its own cadence
              glowNext: rand(0.5, 7),
              glowStart: -999,
              glowDur: 0,
              vx: 0, vy: 0, dx: 0, dy: 0,
            };
            });
          }

          let lastW = 0, lastH = 0;

          function applySize() {
            width = window.innerWidth;
            height = window.innerHeight;
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          }

          function rebuild() {
            applySize();
            lastW = window.innerWidth;
            lastH = window.innerHeight;
            buildStars();
          }

          // Mobile browsers fire `resize` when the URL bar shows/hides while
          // scrolling — that only changes the height by a small amount. Rebuilding
          // the field on every such event makes the stars flicker and teleport, so
          // ignore those: only react to a width change (orientation/resize) or a
          // large height change. Coalesce bursts of events into one rAF tick.
          let resizeRaf = 0;
          function onResize() {
            if (resizeRaf) return;
            resizeRaf = requestAnimationFrame(() => {
              resizeRaf = 0;
              const w = window.innerWidth, h = window.innerHeight;
              if (w === lastW && Math.abs(h - lastH) < 120) return;
              rebuild();
            });
          }

          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          // Touch devices: skip the always-on glow blur (canvas shadowBlur is the
          // single heaviest per-frame cost on mobile GPUs).
          const lowPower = window.matchMedia('(pointer: coarse)').matches;
          // Constellation + magnetism are desktop-only: they need a real cursor and
          // the per-frame spring/line work isn't worth it on phones.
          const enableField = !reduceMotion && !lowPower;

          // ── Text guard ────────────────────────────────────────────────────
          // Stars fade out under headings/paragraphs so copy stays readable —
          // matters most on mobile, where text spans nearly the full width.
          // Element list is collected once (plus on resize); their viewport
          // rects are re-read each frame so scroll/reveal animations track.
          const GUARD_FADE = 36; // px of soft falloff around each text block
          const GUARD_MIN = 0.12; // alpha multiplier right under the text
          let guardEls: HTMLElement[] = [];
          interface GuardRect { l: number; t: number; r: number; b: number; }
          const guardRects: GuardRect[] = [];

          function collectGuardEls() {
            guardEls = Array.from(
              document.querySelectorAll<HTMLElement>('main :is(h1, h2, h3, h4, p)')
            );
          }

          function updateGuardRects() {
            guardRects.length = 0;
            for (const el of guardEls) {
              const r = el.getBoundingClientRect();
              if (r.width === 0 || r.bottom < -GUARD_FADE || r.top > height + GUARD_FADE) continue;
              guardRects.push({ l: r.left, t: r.top, r: r.right, b: r.bottom });
            }
          }

          /** 1 = fully visible, GUARD_MIN = right under text, smooth in between. */
          function guardDim(x: number, y: number): number {
            let dim = 1;
            for (const g of guardRects) {
              const dx = x < g.l ? g.l - x : x > g.r ? x - g.r : 0;
              if (dx > GUARD_FADE) continue;
              const dy = y < g.t ? g.t - y : y > g.b ? y - g.b : 0;
              if (dy > GUARD_FADE) continue;
              const f = GUARD_MIN + (1 - GUARD_MIN) * (Math.max(dx, dy) / GUARD_FADE);
              if (f < dim) dim = f;
              if (dim <= GUARD_MIN + 0.01) return dim;
            }
            return dim;
          }

          let rafId = 0;
          const start = performance.now();
          function draw(now: number) {
            const t = (now - start) / 1000;
            ctx.clearRect(0, 0, width, height);
            updateGuardRects();
            cx += (px - cx) * 0.05;
            cy += (py - cy) * 0.05;

            // Smooth the hover boost.
            hoverCur += (hoverTarget - hoverCur) * 0.12;

            // Frame delta (clamped so a background-tab pause can't teleport meteors).
            const dt = Math.min(Math.max(t - lastT, 0), 0.05);
            lastT = t;

            // Ambient shooting star: every so often one streaks across the top half.
            if (!reduceMotion) {
              if (meteorNext === 0) meteorNext = t + rand(1.5, 4);
              if (t >= meteorNext) {
                meteorNext = t + rand(3.5, 8);
                const fromLeft = Math.random() < 0.5;
                const speed = rand(520, 820);
                const ang = fromLeft ? rand(0.25, 0.5) : Math.PI - rand(0.25, 0.5);
                meteors.push({
                  x: fromLeft ? rand(-40, width * 0.4) : rand(width * 0.6, width + 40),
                  y: rand(0, height * 0.45),
                  vx: Math.cos(ang) * speed,
                  vy: Math.sin(ang) * speed,
                  born: t,
                  dur: rand(0.7, 1.2),
                  len: rand(70, 140),
                });
              }
            }

            // Constellation/magnetism field: radius grows on hover, force flips from
            // gentle attraction (idle) to repulsion (hover = "antigravity").
            const fieldR = enableField ? 120 + hoverCur * 90 : 0;
            const fieldR2 = fieldR * fieldR;
            const forceSign = -1 + hoverCur * 2;
            const near: { x: number; y: number; a: number }[] = [];

            for (const s of stars) {
              // slow, gentle twinkle
              const twinkle = reduceMotion ? 1 : 0.8 + 0.2 * Math.sin(t * s.twinkleSpeed + s.phase);

              // glow burst: schedule next glow, compute a slow, smooth boost
              let glowBoost = 0;
              if (!reduceMotion) {
                if (t >= s.glowNext) {
                  s.glowStart = t;
                  // slow rise and fall: 2.5–5s per glow
                  s.glowDur = rand(2.5, 5);
                  // next glow between 3 and 11 seconds later (each star on its own cadence)
                  s.glowNext = t + rand(3, 11);
                }
                const elapsed = t - s.glowStart;
                if (elapsed >= 0 && elapsed < s.glowDur) {
                  // smooth bell curve using sine: gentle rise and fall
                  const p = elapsed / s.glowDur;
                  glowBoost = Math.sin(p * Math.PI);
                }
              }

              const alpha = Math.min(1, s.baseAlpha * twinkle + glowBoost * (1 - s.baseAlpha));
              // mouse parallax
              const ox = cx * s.depth * 40;
              const oy = cy * s.depth * 40;

              // Magnetism: each star springs back to its resting position; when the
              // cursor is within range it's pulled toward (idle) or pushed away (hover).
              if (enableField) {
                s.vx += -s.dx * 0.012;
                s.vy += -s.dy * 0.012;
                s.vx *= 0.86;
                s.vy *= 0.86;
                const cdx = (s.x + ox) - mx;
                const cdy = (s.y + oy) - my;
                const cd2 = cdx * cdx + cdy * cdy;
                if (cd2 < fieldR2 && cd2 > 0.01) {
                  const cd = Math.sqrt(cd2);
                  const f = (1 - cd / fieldR) * (0.5 + hoverCur * 1.6) * forceSign;
                  s.vx += (cdx / cd) * f;
                  s.vy += (cdy / cd) * f;
                }
                s.dx += s.vx;
                s.dy += s.vy;
              }

              const rx = s.x + ox + s.dx;
              const ry = s.y + oy + s.dy;
              // glow briefly expands the star radius too
              const rad = (s.r * (0.6 + s.depth * 0.6)) * (1 + glowBoost * 0.5);

              // Text guard: fade the star (and its glow) when it sits under copy.
              const dim = guardRects.length ? guardDim(rx, ry) : 1;
              if (dim <= GUARD_MIN + 0.01) continue; // fully hidden under text
              const a = alpha * dim;

              // Collect stars within cursor range so we can wire them up
              // afterwards — dimmed ones stay out so lines don't cross text.
              if (enableField && mx > -9000 && dim > 0.5) {
                const ldx = rx - mx, ldy = ry - my;
                const ld2 = ldx * ldx + ldy * ldy;
                if (ld2 < fieldR2) near.push({ x: rx, y: ry, a: 1 - Math.sqrt(ld2) / fieldR });
              }

              const glowColor =
                s.tone === 'accent' ? 'rgba(110,231,183,0.9)'
                : s.tone === 'gray' ? 'rgba(160,160,170,0.8)'
                : 'rgba(240,240,240,0.8)';
              ctx.shadowBlur = dim < 0.6 ? 0 : glowBoost > 0.05
                ? 8 + glowBoost * 16
                : (!lowPower && s.depth > 0.6 ? 6 : 0);
              ctx.shadowColor = glowColor;

              const fill =
                s.tone === 'accent' ? `rgba(110,231,183,${a})`
                : s.tone === 'gray' ? `rgba(160,160,170,${a})`
                : `rgba(240,240,240,${a})`;

              ctx.beginPath();
              ctx.arc(rx, ry, rad, 0, Math.PI * 2);
              ctx.fillStyle = fill;
              ctx.fill();
            }

            // Constellation lines: link near-cursor stars to each other and to the
            // cursor. Pairwise is cheap because `near` only holds in-range stars.
            if (near.length > 1) {
              ctx.shadowBlur = 0;
              const linkR2 = fieldR2 * 0.7;
              for (let i = 0; i < near.length; i++) {
                const a = near[i];
                const toCursor = a.a * (0.35 + hoverCur * 0.65);
                if (toCursor > 0.02) {
                  ctx.strokeStyle = `rgba(110,231,183,${toCursor})`;
                  ctx.lineWidth = 0.8 + hoverCur * 1.4;
                  ctx.beginPath();
                  ctx.moveTo(a.x, a.y);
                  ctx.lineTo(mx, my);
                  ctx.stroke();
                }
                for (let j = i + 1; j < near.length; j++) {
                  const b = near[j];
                  const dx = a.x - b.x, dy = a.y - b.y;
                  const dd = dx * dx + dy * dy;
                  if (dd < linkR2) {
                    const la = (1 - Math.sqrt(dd) / (fieldR * 0.74)) * Math.min(a.a, b.a) * (0.55 + hoverCur * 0.85);
                    if (la > 0.02) {
                      ctx.strokeStyle = `rgba(110,231,183,${la})`;
                      ctx.lineWidth = 0.8 + hoverCur * 1.4;
                      ctx.beginPath();
                      ctx.moveTo(a.x, a.y);
                      ctx.lineTo(b.x, b.y);
                      ctx.stroke();
                    }
                  }
                }
              }
            }

            ctx.shadowBlur = 0;

            // Meteors: a bright head with a gradient tail that fades in and out.
            for (let i = meteors.length - 1; i >= 0; i--) {
              const m = meteors[i];
              const age = t - m.born;
              if (age > m.dur) { meteors.splice(i, 1); continue; }
              m.x += m.vx * dt;
              m.y += m.vy * dt;
              // Fade the whole meteor while its head crosses a text block.
              const mDim = guardRects.length ? guardDim(m.x, m.y) : 1;
              const a = Math.sin((age / m.dur) * Math.PI) * mDim;
              const sp = Math.hypot(m.vx, m.vy) || 1;
              const tx = m.x - (m.vx / sp) * m.len;
              const ty = m.y - (m.vy / sp) * m.len;
              const grad = ctx.createLinearGradient(m.x, m.y, tx, ty);
              grad.addColorStop(0, `rgba(240,255,250,${0.9 * a})`);
              grad.addColorStop(0.25, `rgba(110,231,183,${0.5 * a})`);
              grad.addColorStop(1, 'rgba(110,231,183,0)');
              ctx.strokeStyle = grad;
              ctx.lineWidth = 1.6;
              ctx.lineCap = 'round';
              ctx.beginPath();
              ctx.moveTo(m.x, m.y);
              ctx.lineTo(tx, ty);
              ctx.stroke();
              ctx.fillStyle = `rgba(255,255,255,${a})`;
              ctx.beginPath();
              ctx.arc(m.x, m.y, 1.4, 0, Math.PI * 2);
              ctx.fill();
            }

            // Supernova rings from background clicks.
            for (let i = shocks.length - 1; i >= 0; i--) {
              const s = shocks[i];
              const age = t - s.born;
              const DUR = 0.8;
              if (age > DUR) { shocks.splice(i, 1); continue; }
              const p = age / DUR;
              const radius = 12 + (1 - Math.pow(1 - p, 3)) * 220;
              ctx.strokeStyle = `rgba(110,231,183,${0.5 * (1 - p)})`;
              ctx.lineWidth = 1.5 * (1 - p) + 0.4;
              ctx.beginPath();
              ctx.arc(s.x, s.y, radius, 0, Math.PI * 2);
              ctx.stroke();
            }

            rafId = requestAnimationFrame(draw);
          }

          window.addEventListener('resize', onResize, { passive: true });
          window.addEventListener('orientationchange', onResize, { passive: true });
          if (!reduceMotion) {
            window.addEventListener('mousemove', (e) => {
              px = (e.clientX / window.innerWidth - 0.5) * 2;
              py = (e.clientY / window.innerHeight - 0.5) * 2;
              mx = e.clientX;
              my = e.clientY;
            }, { passive: true });
            // Cursor left the window — drop the constellation so no lines linger.
            window.addEventListener('mouseout', (e) => {
              if (!e.relatedTarget) { mx = -9999; my = -9999; }
            }, { passive: true });
            // "Antigravity" hover: tagged elements (project cards, hero avatar) make
            // the particles behind them light up and push away from the cursor.
            document.querySelectorAll('[data-particle-hover]').forEach((el) => {
              el.addEventListener('mouseenter', () => { hoverTarget = 1; });
              el.addEventListener('mouseleave', () => { hoverTarget = 0; });
            });

            // Supernova: clicking empty space fires an expanding ring and
            // shoves nearby stars away (they spring back on their own).
            window.addEventListener('pointerdown', (e) => {
              const target = e.target instanceof Element ? e.target : null;
              if (target && target.closest('a, button, input, textarea, select, label, form, nav')) return;
              shocks.push({ x: e.clientX, y: e.clientY, born: (performance.now() - start) / 1000 });
              if (!enableField) return;
              const R = 240, R2 = R * R;
              for (const s of stars) {
                const dx = (s.x + s.dx) - e.clientX;
                const dy = (s.y + s.dy) - e.clientY;
                const d2 = dx * dx + dy * dy;
                if (d2 < R2 && d2 > 1) {
                  const d = Math.sqrt(d2);
                  const f = (1 - d / R) * 14;
                  s.vx += (dx / d) * f;
                  s.vy += (dy / d) * f;
                }
              }
            }, { passive: true });
          }

          // Pause the loop while the tab is hidden — saves battery and CPU.
          document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
              cancelAnimationFrame(rafId);
              rafId = 0;
            } else if (!rafId) {
              rafId = requestAnimationFrame(draw);
            }
          });

          rebuild();
          collectGuardEls();

          // The intro overlay covers the canvas, so don't burn CPU/GPU drawing
          // stars behind it — that contention is what makes the intro feel
          // laggy. Start the loop only once the intro signals it's done (with a
          // safety fallback in case the signal never arrives).
          const startLoop = () => { if (!rafId) rafId = requestAnimationFrame(draw); };
          if (document.documentElement.classList.contains('js-anim')) {
            let started = false;
            const go = () => { if (started) return; started = true; startLoop(); };
            window.addEventListener('intro:done', go, { once: true });
            window.setTimeout(go, 3400);
          } else {
            startLoop();
          }
        }
      }
    </script>

    <script>
      // ── i18n + theme toggle ──────────────────────────────────────────────

      interface Tr { es: string; en: string; }
      type Lang = 'es' | 'en';

      const T: Record<string, Tr> = {
        'nav.home':       { es: 'Inicio',      en: 'Home' },
        'nav.about':      { es: 'Sobre mí',    en: 'About' },
        'nav.experience': { es: 'Experiencia', en: 'Experience' },
        'nav.projects':   { es: 'Proyectos',   en: 'Projects' },
        'nav.contact':    { es: 'Contacto',    en: 'Contact' },

        'hero.available':    { es: 'Disponible para trabajar', en: 'Available for work' },
        'hero.desc':         { es: 'Desarrollador Full Stack con más de 3 años de experiencia construyendo aplicaciones web escalables. Especializado en React, Node.js y APIs REST.', en: 'Full Stack Developer with 3+ years of experience building scalable web applications. Specialized in React, Node.js and REST APIs.' },
        'hero.cta.projects': { es: 'Ver proyectos', en: 'View projects' },
        'hero.cta.contact':  { es: 'Contacto',      en: 'Contact' },

        'about.label': { es: 'Sobre mí',                    en: 'About me' },
        'about.title': { es: 'Un poco de<br />mi historia', en: 'A bit about<br />my story' },

        'contact.label': { es: 'Contacto', en: 'Contact' },
        'contact.title': { es: 'Hablemos', en: "Let's talk" },
        'contact.desc':  { es: 'Si tenés un proyecto en mente, una pregunta o simplemente querés conectar — mandame un mensaje.', en: "If you have a project in mind, a question, or just want to connect — send me a message." },

        'exp.label': { es: 'Experiencia',         en: 'Experience' },
        'exp.title': { es: 'Dónde he trabajado',  en: "Where I've worked" },

        'projects.label': { es: 'Proyectos',            en: 'Projects' },
        'projects.title': { es: 'Trabajo seleccionado', en: 'Selected work' },
        'projects.sub':   { es: 'Proyectos personales, diseñados y construidos de principio a fin.', en: 'Personal projects, designed and built end to end.' },
      };

      function applyLang(lang: Lang) {
        document.documentElement.dataset.lang = lang;
        localStorage.setItem('lang', lang);
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const entry = T[el.dataset.i18n!];
          if (entry) el.textContent = entry[lang];
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
          const entry = T[el.dataset.i18nHtml!];
          if (entry) el.innerHTML = entry[lang];
        });
        const btn = document.getElementById('lang-toggle');
        if (btn) btn.textContent = lang === 'es' ? 'EN' : 'ES';
      }

      document.addEventListener('DOMContentLoaded', () => {
        const lang = (localStorage.getItem('lang') || 'es') as Lang;
        applyLang(lang);

        document.getElementById('lang-toggle')?.addEventListener('click', () => {
          applyLang(document.documentElement.dataset.lang === 'es' ? 'en' : 'es');
        });
      });
    </script>
  </body>
</html>
